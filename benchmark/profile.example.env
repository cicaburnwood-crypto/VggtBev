# Example only. The archived launchers require this as profile_5090.env in
# their configured deployment tree; configure paths before live qualification.
# No model/scene is downloaded, and sourcing this file does not start a job.
DEPLOYMENT_ROOT="${DEPLOYMENT_ROOT:?set the directory containing baseline_verifier and databuilder}"
BENCHMARK_ROOT="$DEPLOYMENT_ROOT/baseline_verifier/procthor_20k_benchmark"
DATABUILDER_ROOT="$DEPLOYMENT_ROOT/databuilder"
WORKER_PYTHON="${WORKER_PYTHON:?set the ProcTHOR scene-worker Python}"
SINGLE_PYTHON="${SINGLE_PYTHON:?set the SHM model Python}"
BASELINE_PYTHON="${BASELINE_PYTHON:?set the other-baseline model Python}"
DATASET_DIR="${DATASET_DIR:?set the stored ProcTHOR-10K dataset directory}"
SINGLE_CHECKPOINT="${SINGLE_CHECKPOINT:?set the accepted Single Baseline checkpoint}"
BACKBONE_SOURCE="$DEPLOYMENT_ROOT/baseline_verifier/vendor/backbone"
BACKBONE_CHECKPOINT="${BACKBONE_CHECKPOINT:?set the frozen VGGT checkpoint}"
BASELINE_ASSETS="${BASELINE_ASSETS:?set the external source and weight directory}"
BENCHMARK_CPU_THREADS_PER_WORKER=8
